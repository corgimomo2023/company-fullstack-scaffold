          "rounded": "{rounded.md}",
          "padding": "12px",
          "height": "44px"
        },
        "input-disabled": {
          "backgroundColor": "{colors.surface-disabled}",
          "textColor": "{colors.text}",
          "typography": "{typography.body-md}",
          "rounded": "{rounded.md}",
          "padding": "12px",
          "height": "44px"
        },
        "card-default": {
          "backgroundColor": "{colors.surface}",
          "textColor": "{colors.text}",
          "rounded": "{rounded.md}",
