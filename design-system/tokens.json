  "$extensions": {
    "com.github.corgimomo2023.company-fullstack-scaffold": {
      "generator": "@google/design.md@0.4.0 plus scripts/export_design_system.py",
      "normativeSource": "DESIGN.md",
      "componentContract": {
        "button-primary": {
          "backgroundColor": "{colors.primary}",
          "textColor": "{colors.surface}",
          "typography": "{typography.label}",
          "rounded": "{rounded.md}",
          "padding": "12px",
          "height": "44px"
        },
        "button-primary-hover": {
          "backgroundColor": "{colors.primary-dark}",
          "textColor": "{colors.surface}",
          "typography": "{typography.label}",
          "rounded": "{rounded.md}",
          "padding": "12px",
          "height": "44px"
        },
