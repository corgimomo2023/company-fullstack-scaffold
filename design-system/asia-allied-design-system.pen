              "fontWeight": "700",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "cover-copy",
              "content": "Evidence-based digital baseline for admin, CMS and operational products.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 22,
              "fontWeight": "400",
              "lineHeight": 1.45,
              "fill": "$color-surface"
            }
          ]
        },
        {
          "type": "frame",
          "id": "cover-facts",
          "name": "Coverage facts",
          "layout": "vertical",
          "gap": 16,
          "padding": 32,
          "width": "fill_container",
          "height": "fit_content",
          "fill": "$color-surface-subtle",
          "cornerRadius": "$radius-md",
          "children": [
            {
              "type": "text",
              "id": "cover-fact-a",
              "content": "10,666 unique sitemap URLs",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 22,
              "fontWeight": "700",
              "lineHeight": 1.35,
              "fill": "$color-text"
            },
            {
              "type": "text",
              "id": "cover-fact-b",
              "content": "559 locale-specific route signatures · 559/559 HTTP 200",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 18,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-text"
            },
            {
              "type": "text",
              "id": "cover-fact-c",
              "content": "43 route/content profiles × 3 viewports · 129/129",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 18,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-text"
            },
            {
              "type": "text",
              "id": "cover-fact-d",
              "content": "62 token records · 52 component evidence records",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 18,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-text"
            }
          ]
        },
        {
          "type": "text",
          "id": "cover-note",
          "content": "Observed source values, normalized product mappings and accessibility corrections remain explicitly classified in DESIGN.md and the evidence register.",
          "width": "fill_container",
          "height": "fit_content",
          "textGrowth": "fixed-width",
          "fontFamily": "Roboto",
          "fontSize": 14,
          "fontWeight": "400",
          "lineHeight": 1.35,
          "fill": "$color-text-muted"
        }
