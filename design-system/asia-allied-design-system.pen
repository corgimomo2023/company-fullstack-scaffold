              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-5",
              "content": "+ Support English/繁體中文 without hierarchy changes.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-6",
              "content": "+ Preserve loading, empty, error, success and action states.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-7",
              "content": "+ Re-run the evidence audit when source CSS hashes change.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
