            {
              "type": "text",
              "id": "guidance-do-0",
              "content": "+ Use deep green structurally and orange as restrained accent.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
