      "type": "frame",
      "id": "guidance",
      "name": "Do and don't",
      "layout": "vertical",
      "gap": 18,
      "padding": 40,
      "width": 1200,
      "height": 1240,
      "fill": "$color-surface",
      "cornerRadius": "$radius-md",
      "children": [
        {
          "type": "text",
          "id": "guidance-title",
          "content": "Do and don't",
          "width": "fill_container",
          "height": "fit_content",
          "textGrowth": "fixed-width",
          "fontFamily": "Pragati Narrow",
          "fontSize": 34,
          "fontWeight": "700",
          "lineHeight": 1.35,
          "fill": "$color-text"
        },
        {
          "type": "text",
          "id": "guidance-subtitle",
          "content": "Operational guardrails from the normative specification",
          "width": "fill_container",
          "height": "fit_content",
          "textGrowth": "fixed-width",
          "fontFamily": "Roboto",
          "fontSize": 14,
          "fontWeight": "400",
          "lineHeight": 1.35,
          "fill": "$color-text-muted"
        },
        {
          "type": "frame",
          "id": "guidance-do",
          "name": "Do",
          "layout": "vertical",
          "gap": 11,
          "padding": 24,
          "width": "fill_container",
          "height": 460,
          "fill": "$color-primary",
          "cornerRadius": "$radius-none",
          "children": [
            {
              "type": "text",
              "id": "guidance-do-title",
              "content": "DO",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 24,
              "fontWeight": "700",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-0",
              "content": "+ Use deep green structurally and orange as restrained accent.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-1",
              "content": "+ Build from normative tokens/contracts, not hardcoded colors.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-2",
              "content": "+ Use real project imagery only when it improves understanding.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-3",
              "content": "+ Keep operational products clear, dense and predictable.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-4",
              "content": "+ Validate text, focus and non-text contrast to WCAG AA.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-5",
              "content": "+ Support English/繁體中文 without hierarchy changes.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-6",
              "content": "+ Preserve loading, empty, error, success and action states.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-7",
              "content": "+ Re-run the evidence audit when source CSS hashes change.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            }
          ]
        },
        {
          "type": "frame",
          "id": "guidance-dont",
          "name": "Don't",
          "layout": "vertical",
          "gap": 11,
          "padding": 24,
          "width": "fill_container",
          "height": 460,
          "fill": "$color-danger",
          "cornerRadius": "$radius-none",
          "children": [
            {
              "type": "text",
              "id": "guidance-dont-title",
              "content": "DON'T",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 24,
              "fontWeight": "700",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-0",
              "content": "− Do not call this an official corporate brand manual.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-1",
              "content": "− Do not copy the public hero, carousel or mega-menu into admin.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-2",
              "content": "− Do not place normal white text on raw #E6762D.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-3",
              "content": "− Do not use logo colors as generic product statuses.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-4",
              "content": "− Do not introduce pink, neon, glass or unrelated gradients.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-5",
              "content": "− Do not use giant rounded cards or consumer-app softness.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-6",
              "content": "− Do not put essential text on untested project imagery.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-dont-7",
              "content": "− Do not import public CSS, logos, icon fonts or content.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            }
          ]
        }
      ],
