              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-3",
              "content": "+ Keep operational products clear, dense and predictable.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
              "lineHeight": 1.35,
              "fill": "$color-surface"
            },
            {
              "type": "text",
              "id": "guidance-do-4",
              "content": "+ Validate text, focus and non-text contrast to WCAG AA.",
              "width": "fill_container",
              "height": "fit_content",
              "textGrowth": "fixed-width",
              "fontFamily": "Roboto",
              "fontSize": 13,
              "fontWeight": "400",
