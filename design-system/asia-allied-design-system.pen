    {
      "type": "frame",
      "id": "cover",
      "name": "Cover",
      "layout": "vertical",
      "gap": 20,
      "padding": 40,
      "width": 1200,
      "height": 1240,
      "fill": "$color-surface",
      "cornerRadius": "$radius-md",
      "children": [
        {
          "type": "text",
          "id": "cover-title",
          "content": "Cover",
          "width": "fill_container",
          "height": "fit_content",
          "textGrowth": "fixed-width",
          "fontFamily": "Pragati Narrow",
          "fontSize": 34,
          "fontWeight": "700",
          "lineHeight": 1.35,
          "fill": "$color-text"
        },
        {
          "type": "text",
          "id": "cover-subtitle",
          "content": "Visual derivative of DESIGN.md · generated, not a second source of truth",
          "width": "fill_container",
          "height": "fit_content",
          "textGrowth": "fixed-width",
          "fontFamily": "Roboto",
          "fontSize": 14,
          "fontWeight": "400",
          "lineHeight": 1.35,
